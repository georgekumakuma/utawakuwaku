{
  "name": "utawakuwaku",
  "version": "3.2.0",
  "description": "YouTube区間再生・プレイリスト管理ツール（歌枠プレイヤー）",
  "main": "main-electron.js",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "test": "node --test test/core.test.mjs",
    "test:e2e": "node test/ui.e2e.mjs && node test/engine.e2e.mjs && node test/features.e2e.mjs && node test/trim.e2e.mjs && node test/discover.e2e.mjs && node test/inapp.e2e.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.yourcompany.utawakuwaku",
    "productName": "utawakuwaku",
    "copyright": "Copyright © 2025 kumakuma",
    "files": [
      "**/*",
      "!test/**",
      "!docs/**"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "win": {
      "icon": "icon.png",
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^27.1.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
